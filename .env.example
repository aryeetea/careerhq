# Bloom — Supabase project settings. Find these in Supabase Dashboard → Project Settings → API.
# Safe to expose in the browser: the anon key only works within your Row Level Security policies.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Never put the service_role key in a VITE_ variable — it would ship to the browser.

# Push notifications (optional) — the public half of a VAPID keypair, safe to
# expose in the browser (it identifies the server to the browser's push
# service, it isn't a secret). Generate a pair with `npx web-push generate-
# vapid-keys`; set the private key + a subject (mailto: or https:// URL) as
# VAPID_PRIVATE_KEY / VAPID_SUBJECT Supabase secrets — never here. Leaving
# this unset just disables push subscribing; nothing else breaks.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
