# Bloom — Supabase project settings. Find these in Supabase Dashboard → Project Settings → API.
# Safe to expose in the browser: the anon key only works within your Row Level Security policies.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Never put the service_role key in a VITE_ variable — it would ship to the browser.
